# Leave HA_URL / HA_TOKEN empty to read from ~/.kiro/settings/homeassistant.json
HA_URL=
HA_TOKEN=

IGNITION_ENTITY=sensor.kzb_38_l_ignition_state
ODOMETER_ENTITY=sensor.kzb_38_l_odometer
TRACKER_ENTITY=device_tracker.kzb_38_l_device_tracker

# Comma-separated list of HA zones that count as "work"
WORK_ZONES=zone.werk

PRIVATE_KM_BUDGET=500
MIN_TRIP_KM=0.5
DB_PATH=./data/kilometers.db
